{
  "name": "expo-cache-provider",
  "description": "A hybrid cache provider for Expo that checks local disk first, then S3 on cache miss",
  "version": "0.1.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@expo/fingerprint": "^0.15.4",
    "env-paths": "^2.2.1",
    "tar": "^7.5.2",
    "expo-native-cache-provider": "^0.1.0"
  },
  "peerDependencies": {
    "@expo/config": "*"
  },
  "devDependencies": {
    "@expo/config": "^12.0.0",
    "@types/node": "^20.0.0",
    "@types/tar": "^6.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "expo-cache-provider": "dist/scripts/cli.js"
  }
}